    box_height = 136.0
    box_width = 560.0
    cx = 336.0
    cy = 176.0
    output = "HDMI-A-1"
    rotation = -0.0
    type = "clock"

        [desktop_widgets.widget.desktop-widget-0000000000000008.settings]
        background = false

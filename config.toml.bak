[backdrop]
blur_intensity = 0.0
enabled = true
tint_intensity = 0.45000000000000001

[bar]
order = [ "default", "sidebar" ]

    [bar.default]
    capsule_thickness = 0.84999998472630978
    center = [ "clock", "spacer_4", "date", "spacer_2", "weather", "spacer_5", "ram" ]
    end = [ "notifications", "clipboard", "volume", "session", "spacer_1", "tray" ]
    margin_edge = 0
    radius = 0
    scale = 1.05
    shadow = false
    start = [ "spacer_4", "launcher", "workspaces" ]
    thickness = 40
    widget_spacing = 10

    [bar.sidebar]
    border = "secondary"
    center = [ "taskbar" ]
    contact_shadow = true
    enabled = true
    end = []
    margin_ends = 100
    position = "left"
    radius = 57
    start = []
    thickness = 60

[desktop_widgets]
schema_version = 2
widget_order = [
    "desktop-widget-0000000000000001",
    "desktop-widget-0000000000000002",
    "desktop-widget-0000000000000006",
    "desktop-widget-0000000000000007",
    "desktop-widget-0000000000000008",
    "desktop-widget-0000000000000009",
    "desktop-widget-000000000000000a",
    "desktop-widget-000000000000000b",
    "desktop-widget-000000000000000c"
]

    [desktop_widgets.grid]
    cell_size = 8
    major_interval = 4
    visible = true

    [desktop_widgets.widget.desktop-widget-0000000000000001]

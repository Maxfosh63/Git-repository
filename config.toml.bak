[dock]
background_opacity = 0.52999998815357685
icon_size = 35
inactive_opacity = 0.99999997764825821
inactive_scale = 1.0
launcher_position = "start"
magnification_scale = 1.3000000044703484
pinned = [
    "calls",
    "brave",
    "btop",
    "thunar",
    "lutris",
    "Spotify (Launcher)",
    "pinta",
    "neovim",
    "onlyoffice",
    "Libreoffice Impress",
    "libreoffice writer",
    "libreoffice draw",
    "libreoffice base",
    "libreoffice math",
    "libreoffice calc",
    "qalculate!"
]
position = "left"
reserve_space = false
show_running = false

[location]
auto_locate = true

[lockscreen_widgets]
enabled = false
schema_version = 2
widget_order = [ "lockscreen-login-box@winit", "lockscreen-login-box@HDMI-A-1" ]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-1"]
    box_height = 70.0
    box_width = 400.0
    cx = 960.0
    cy = 961.0
    output = "HDMI-A-1"
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-1".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        input_opacity = 1.0
        input_radius = 6.0
        show_login_button = true

    [lockscreen_widgets.widget."lockscreen-login-box@winit"]
    box_height = 70.0
    box_width = 400.0
    cx = 464.0
    cy = 847.0
    output = "winit"
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@winit".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        input_opacity = 1.0
        input_radius = 6.0
        show_login_button = true

[plugins]
enabled = [ "noctalia/mpvpaper" ]

[shell]
font_family = "JetBrainsMonoNL Nerd Font"
settings_show_advanced = true

    [shell.panel]
    transparency_mode = "glass"

    [[shell.session.actions]]
    action = "lock"
    enabled = true
    variant = "default"

    [[shell.session.actions]]
    action = "logout"
    enabled = true
    variant = "default"

    [[shell.session.actions]]
    action = "lock_and_suspend"
    enabled = true
    variant = "default"

    [[shell.session.actions]]
    action = "reboot"
    enabled = true
    variant = "default"

    [[shell.session.actions]]
    action = "shutdown"
    enabled = true
    variant = "destructive"

[theme]
builtin = "Eldritch"
community_palette = "Oxocarbon"
custom_palette = "wallpaperflare-com-wallpaper-2-mc"
source = "custom"

    [theme.templates]
    builtin_ids = [ "gtk3", "gtk4", "kcolorscheme" ]
    community_ids = [ "neovim", "fuzzel", "rofi" ]

[wallpaper]
directory = "/home/l/Pictures/Wallpapers/"

    [wallpaper.default]
    path = "/home/l/Pictures/Wallpapers/wallpaperflare.com_wallpaper (2).jpg"

    [wallpaper.last]
    path = "/home/l/Pictures/Wallpapers/wallpaperflare.com_wallpaper (2).jpg"

    [wallpaper.monitors.HDMI-A-1]
    path = "/home/l/Pictures/Wallpapers/wallpaperflare.com_wallpaper (2).jpg"

    [[wallpaper.favorite]]
    path = "/home/l/Pictures/Wallpapers/wallpaperflare.com_wallpaper (2).jpg"
    theme_mode = "auto"

[weather]
refresh_minutes = 5

[widget.active_window]
color = "primary"
display = "icon_only"
icon_color = "primary"
icon_size = 16.0
max_length = 40
min_length = 0

[widget.audio_visualizer]
bands = 25
scale = 1.5
width = 204.0

[widget.clipboard]
color = "primary"

[widget.clock]
capsule_border = "primary"
color = "primary"
font_family = "JetBrainsMono Nerd Font"
format = "{:%I:%M %p}"
scale = 1.05

[widget.custom_button_2]
type = "custom_button"

[widget.date]
color = "primary"

[widget.launcher]
color = "primary"

[widget.mpvpaper]
type = "noctalia/mpvpaper:mpvpaper"

[widget.mpvpaper_2]
type = "noctalia/mpvpaper:mpvpaper"

[widget.notifications]
color = "primary"

[widget.ram]
capsule_border = "primary"
color = "primary"
display = "text"

[widget.session]
anchor = true
color = "primary"

[widget.spacer_1]
length = 8
type = "spacer"

[widget.spacer_2]
length = 30
type = "spacer"

[widget.spacer_3]
type = "spacer"

[widget.spacer_4]
length = 10
type = "spacer"

[widget.spacer_5]
length = 30
type = "spacer"

[widget.sysmon]
color = "primary"
display = "text"

[widget.taskbar]
capsule_radius = 8
group_by_workspace = true
inactive_opacity = 0.75
scale = 1.7
show_active_indicator = false

[widget.temp]
capsule_border = "primary"
capsule_padding = 15.0
color = "primary"
display = "text"
icon_color = "primary"

[widget.tray]
color = "primary"
drawer = true
icon_color = "secondary"

[widget.volume]
color = "primary"
show_label = false

[widget.wallpaper]
color = "primary"

[widget.weather]
capsule_border = "primary"
color = "primary"

[widget.workspaces]
capsule_border = "primary"
minimal = true
scale = 1.2
